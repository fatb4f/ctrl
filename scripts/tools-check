#!/bin/sh
set -eu

if ! command -v uv >/dev/null 2>&1; then
    echo "missing: uv" >&2
    exit 1
fi

if ! command -v just >/dev/null 2>&1; then
    echo "missing: just" >&2
    exit 1
fi

if ! command -v cue >/dev/null 2>&1; then
    echo "missing: cue" >&2
    exit 1
fi

cue_language_version=$(cue version | sed -n 's/^CUE language version //p')
if [ "$cue_language_version" != "v0.18.0" ]; then
    echo "unsupported CUE language version: $cue_language_version (expected v0.18.0)" >&2
    exit 1
fi

python_version=$(uv run --no-project --python 3.14 python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
if [ "$python_version" != "3.14" ]; then
    echo "unsupported Python version: $python_version (expected 3.14)" >&2
    exit 1
fi

if ! command -v lazyjust >/dev/null 2>&1; then
    echo "optional: lazyjust not installed"
fi
