default:
    @just --list

sync:
    uv sync --locked --group dev

lock:
    uv lock --upgrade
    uv sync --group dev

version new:
    uv version {{new}} --no-sync

tools-check:
    @command -v uv >/dev/null 2>&1 || { echo "missing: uv" >&2; exit 1; }
    @command -v just >/dev/null 2>&1 || { echo "missing: just" >&2; exit 1; }
    @command -v cue >/dev/null 2>&1 || { echo "missing: cue" >&2; exit 1; }
    @command -v lazyjust >/dev/null 2>&1 || echo "optional: lazyjust not installed"

test *args:
    uv run --frozen --no-sync pytest {{args}}

lint:
    uv run --frozen --no-sync ruff check .

format-check:
    uv run --frozen --no-sync ruff format --check .

typecheck:
    uv run --frozen --no-sync ty check src tests scripts

fix:
    uv run --frozen --no-sync ruff check --fix .
    uv run --frozen --no-sync ruff format .

build:
    rm -rf dist
    uv build

check: lint format-check typecheck planning-contract-check test

planning-contract-check:
    cue vet -c=false contracts/planning/examples/normalized_sequence.cue

workflow-generate:
    uv run --frozen --no-sync python-ppf workflow plan docs/workflow-plan-example.md --fixtures fixtures/manifest.cue --probes fixtures/probes.cue --realizations fixtures/realization-specs.cue --output generated/workflow/example.json

workflow-generate-check:
    uv run --frozen --no-sync python-ppf workflow plan docs/workflow-plan-example.md --fixtures fixtures/manifest.cue --probes fixtures/probes.cue --realizations fixtures/realization-specs.cue --check generated/workflow/example.json

workflow-validate:
    uv run --frozen --no-sync python-ppf workflow plan docs/workflow-plan-example.md --fixtures fixtures/manifest.cue --probes fixtures/probes.cue --realizations fixtures/realization-specs.cue --check generated/workflow/example.json

test-clean-locked *args:
    uv run --isolated --locked --no-default-groups --group test pytest {{args}}

test-clean *args:
    just test-clean-locked {{args}}

package-check:
    uv run --isolated --locked --no-default-groups --group test python scripts/package_check.py dist tdd_agent_skills

package-check-online:
    uv run --isolated --locked --no-default-groups --group test python scripts/package_check.py --online dist tdd_agent_skills

standards-check:
    uv run --isolated --no-project python scripts/standards_check.py

qualify: check test-clean-locked build standards-check

[private]
ui:
    @command -v lazyjust >/dev/null 2>&1 || { echo "optional tool missing: lazyjust" >&2; exit 127; }
    @lazyjust {{ quote(justfile_directory()) }}
